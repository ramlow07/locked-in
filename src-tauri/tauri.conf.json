{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locked In",
  "version": "0.1.1",
  "identifier": "com.luamramlow.lockedin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420/app.html",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Locked In",
        "url": "app.html",
        "width": 920,
        "height": 720,
        "minWidth": 520,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMzgwMUNCNzVFNkRCRDgKUldUWTIrWjF5d0U0cTZYNWRwTVpnaDA4N0ZXdkdnWC9wQVB5d09Ic2NhUXpIMW1QSnhKTXI2aEMK",
      "endpoints": [
        "https://github.com/ramlow07/locked-in/releases/latest/download/latest.json"
      ]
    }
  }
}
